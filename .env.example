# Copy to .env and adjust. Never commit .env.

# OLX Lebanon web origin
OLX_BASE_URL=https://www.olx.com.lb

# Where the saved login session (cookies + auth headers) lives. Treat as a secret.
OLX_SESSION_FILE=.olx-session/session.json

# Endpoint map and category/location catalog (copy from config/*.example.json)
OLX_ENDPOINTS_FILE=config/endpoints.json
OLX_CATALOG_FILE=config/catalog.json

# Product ID <-> OLX ad ID mapping store
OLX_SYNC_STORE_FILE=data/sync-store.json

# Every call to OLX is logged here (no bodies, cookies or tokens)
OLX_REQUEST_LOG_FILE=logs/requests.jsonl

# Write throttling — keep it human-paced
OLX_MIN_WRITE_INTERVAL_MS=60000
OLX_WRITE_JITTER_MS=15000
OLX_MAX_WRITES_PER_HOUR=20

# Optional: only fetch product images from these hosts (comma-separated). Listed hosts are
# trusted as-is (http / LAN allowed). Unset: any https host that resolves to a public address.
OLX_IMAGE_HOSTS=

# Optional: non-OLX hosts the web app talks to (e.g. an image CDN). Recorded by `npm run capture`
# and watched for auth headers by `npm run login`. Comma-separated.
OLX_EXTRA_HOSTS=

# Optional: extra auth header names to save at login (comma-separated), on top of
# authorization, x-access-token, x-auth-token, x-csrf-token
OLX_CAPTURE_HEADERS=

# Local REST service (called by your store backend)
SERVER_HOST=127.0.0.1
SERVER_PORT=8787
# Required to run the server. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVER_API_KEY=

# Optional: POSTed a signed JSON copy of every finished job. https required (http only for localhost).
WEBHOOK_URL=
# Required with WEBHOOK_URL; must differ from SERVER_API_KEY. Used for the X-Olx-Sdk-Signature HMAC.
WEBHOOK_SECRET=

LOG_LEVEL=info
