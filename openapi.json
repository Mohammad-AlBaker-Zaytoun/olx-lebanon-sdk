{
  "openapi": "3.1.0",
  "info": {
    "title": "olx-lebanon-sdk REST service",
    "version": "0.4.0",
    "description": "Post, edit and delete your own OLX Lebanon ads from any language. Writes are queued and paced: they answer 202 with a job id; poll GET /v1/jobs/{jobId} or configure a webhook for the outcome. Each product keeps exactly one ad. Errors always have the shape `{ \"error\": { \"code\", \"message\", \"details\"?, \"requestId\" } }`; branch on `code`.",
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8787",
      "description": "Default local service (`olx-lb serve`)"
    }
  ],
  "security": [
    {
      "ApiKey": []
    }
  ],
  "tags": [
    {
      "name": "Listings",
      "description": "Your products' ads"
    },
    {
      "name": "Jobs",
      "description": "Outcome of queued writes"
    },
    {
      "name": "Service",
      "description": "Health, status and this document"
    }
  ],
  "paths": {
    "/v1/health": {
      "get": {
        "tags": [
          "Service"
        ],
        "operationId": "getHealth",
        "summary": "Liveness check",
        "security": [],
        "responses": {
          "200": {
            "description": "The service is up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "const": true
                    }
                  },
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/openapi.json": {
      "get": {
        "tags": [
          "Service"
        ],
        "operationId": "getOpenApi",
        "summary": "This OpenAPI document",
        "security": [],
        "responses": {
          "200": {
            "description": "The OpenAPI document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/status": {
      "get": {
        "tags": [
          "Service"
        ],
        "operationId": "getStatus",
        "summary": "Session, queue, write pacing, and products that need attention",
        "responses": {
          "200": {
            "description": "Service status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong X-Api-Key (`unauthorized`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal error (`internal_error`); details are in the service log",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/listings": {
      "get": {
        "tags": [
          "Listings"
        ],
        "operationId": "listListings",
        "summary": "Every stored product ↔ ad link",
        "responses": {
          "200": {
            "description": "All links",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "listings": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SyncRecord"
                      }
                    }
                  },
                  "required": [
                    "listings"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong X-Api-Key (`unauthorized`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal error (`internal_error`); details are in the service log",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/products/{productId}/listing": {
      "parameters": [
        {
          "name": "productId",
          "in": "path",
          "required": true,
          "description": "Your product's id: 1-128 letters, digits and . _ : -",
          "schema": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,128}$"
          }
        }
      ],
      "get": {
        "tags": [
          "Listings"
        ],
        "operationId": "getListing",
        "summary": "A product's link to its ad",
        "responses": {
          "200": {
            "description": "The link",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncRecord"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong X-Api-Key (`unauthorized`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No link for this product (`not_found`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal error (`internal_error`); details are in the service log",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Listings"
        ],
        "operationId": "upsertListing",
        "summary": "Create the product's ad, or edit it in place",
        "description": "Queues a sync: the first time it posts an ad, later it edits the same ad, and unchanged content is skipped (use `force=true` to push anyway). Photos are only re-uploaded when they change.",
        "parameters": [
          {
            "name": "force",
            "in": "query",
            "required": false,
            "description": "Push even if the content is unchanged",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "1"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Listing"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            }
          },
          "400": {
            "description": "Invalid product id or listing (`invalid_product_id`, `invalid_listing` with `details.issues`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong X-Api-Key (`unauthorized`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Body over 1 MB (`payload_too_large`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many products waiting (`queue_full`); retry after `Retry-After` seconds",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal error (`internal_error`); details are in the service log",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Shutting down (`shutting_down`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Listings"
        ],
        "operationId": "deleteListing",
        "summary": "Delete the product's ad",
        "responses": {
          "202": {
            "description": "Queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            }
          },
          "400": {
            "description": "Invalid product id (`invalid_product_id`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong X-Api-Key (`unauthorized`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many products waiting (`queue_full`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal error (`internal_error`); details are in the service log",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Shutting down (`shutting_down`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/products/{productId}/listing/deactivate": {
      "parameters": [
        {
          "name": "productId",
          "in": "path",
          "required": true,
          "description": "Your product's id: 1-128 letters, digits and . _ : -",
          "schema": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,128}$"
          }
        }
      ],
      "post": {
        "tags": [
          "Listings"
        ],
        "operationId": "deactivateListing",
        "summary": "Take the product's ad offline without deleting it",
        "description": "Queued and paced. The link stays; the next PUT brings the ad back with a republish.",
        "responses": {
          "202": {
            "description": "Queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            }
          },
          "400": {
            "description": "Invalid product id (`invalid_product_id`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong X-Api-Key (`unauthorized`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many products waiting (`queue_full`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal error (`internal_error`); details are in the service log",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Shutting down (`shutting_down`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/products/{productId}/listing/activate": {
      "parameters": [
        {
          "name": "productId",
          "in": "path",
          "required": true,
          "description": "Your product's id: 1-128 letters, digits and . _ : -",
          "schema": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,128}$"
          }
        }
      ],
      "post": {
        "tags": [
          "Listings"
        ],
        "operationId": "activateListing",
        "summary": "Put the product's `limited` ad live with a free slot",
        "description": "Queued and paced. The job result has `result`: `activated`, `needs_package` (no free slot left; a package is needed on OLX, which the service never buys) or `not_limited`.",
        "responses": {
          "202": {
            "description": "Queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            }
          },
          "400": {
            "description": "Invalid product id (`invalid_product_id`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong X-Api-Key (`unauthorized`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many products waiting (`queue_full`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal error (`internal_error`); details are in the service log",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Shutting down (`shutting_down`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/products/{productId}/listing/sold": {
      "parameters": [
        {
          "name": "productId",
          "in": "path",
          "required": true,
          "description": "Your product's id: 1-128 letters, digits and . _ : -",
          "schema": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,128}$"
          }
        }
      ],
      "post": {
        "tags": [
          "Listings"
        ],
        "operationId": "markListingSold",
        "summary": "Mark the product's ad as sold",
        "description": "Queued and paced. A sold ad can only be deleted; resolve with `forget` to post a new ad for the product.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "soldOn": {
                    "type": "string",
                    "enum": [
                      "olx",
                      "elsewhere"
                    ]
                  }
                },
                "required": [
                  "soldOn"
                ]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            }
          },
          "400": {
            "description": "Invalid product id or body (`invalid_product_id`, `bad_request`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong X-Api-Key (`unauthorized`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many products waiting (`queue_full`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal error (`internal_error`); details are in the service log",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Shutting down (`shutting_down`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/products/{productId}/listing/metrics": {
      "parameters": [
        {
          "name": "productId",
          "in": "path",
          "required": true,
          "description": "Your product's id: 1-128 letters, digits and . _ : -",
          "schema": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,128}$"
          }
        }
      ],
      "get": {
        "tags": [
          "Listings"
        ],
        "operationId": "getListingMetrics",
        "summary": "Views and leads for the product's ad",
        "responses": {
          "200": {
            "description": "Metrics (null when OLX has no numbers yet)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "productId": {
                      "type": "string"
                    },
                    "adId": {
                      "type": "string"
                    },
                    "metrics": {
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/AdMetrics"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "productId",
                    "adId",
                    "metrics"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong X-Api-Key (`unauthorized`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No ad linked to this product (`not_found`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal error (`internal_error`); details are in the service log",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/listings/refresh": {
      "post": {
        "tags": [
          "Listings"
        ],
        "operationId": "refreshListings",
        "summary": "Re-read every linked ad's status from OLX",
        "description": "Queued. Reads \"My ads\" and stores statuses that changed (expired, rejected, live after review). The job result has `updated` (links), `missing` (product ids whose ad was not found) and `checked`.",
        "responses": {
          "202": {
            "description": "Queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong X-Api-Key (`unauthorized`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many products waiting (`queue_full`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal error (`internal_error`); details are in the service log",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Shutting down (`shutting_down`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/products/{productId}/listing/resolve": {
      "parameters": [
        {
          "name": "productId",
          "in": "path",
          "required": true,
          "description": "Your product's id: 1-128 letters, digits and . _ : -",
          "schema": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,128}$"
          }
        }
      ],
      "post": {
        "tags": [
          "Listings"
        ],
        "operationId": "resolveListing",
        "summary": "Resolve a parked product (needs_reconcile or gone)",
        "description": "`link`: the ad exists on OLX, manage it from now on (also adopts an ad posted by hand). `forget`: no ad exists, the next sync creates one. Both refuse unsafe cases with 409 unless `replace` / `force` is set.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Resolution"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resolved",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/SyncRecord"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "forgotten": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "forgotten"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid product id or body (`invalid_product_id`, `invalid_resolution`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong X-Api-Key (`unauthorized`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Would orphan or share an ad (`link_conflict`, `healthy_link`; `details.adId`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal error (`internal_error`); details are in the service log",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/jobs/{jobId}": {
      "parameters": [
        {
          "name": "jobId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "tags": [
          "Jobs"
        ],
        "operationId": "getJob",
        "summary": "A queued write and its outcome",
        "responses": {
          "200": {
            "description": "The job",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong X-Api-Key (`unauthorized`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Unknown or expired job (`not_found`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal error (`internal_error`); details are in the service log",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key",
        "description": "SERVER_API_KEY from the service settings"
      }
    },
    "schemas": {
      "Listing": {
        "type": "object",
        "description": "An ad. Give the category as `categoryId` (an OLX id) or `categoryKey` (your catalog), and the location as `locationId` (an OLX area id) or `locationKey`, or leave the location out to use the catalog's `listingDefaults`. A `listingDefaults.descriptionFooter` is added to the description when the job runs.",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 70
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "price": {
            "oneOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "string",
                "pattern": "^\\s*\\d+(\\.\\d+)?\\s*$"
              }
            ],
            "description": "A number, or a decimal string such as \"799.00\""
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD",
              "LBP"
            ],
            "default": "USD"
          },
          "categoryId": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^\\d+$"
              },
              {
                "type": "integer",
                "minimum": 1
              }
            ],
            "examples": [
              "175"
            ]
          },
          "categoryKey": {
            "type": "string",
            "minLength": 1
          },
          "locationId": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^\\d+$"
              },
              {
                "type": "integer",
                "minimum": 1
              }
            ],
            "examples": [
              "47"
            ]
          },
          "locationKey": {
            "type": "string",
            "minLength": 1
          },
          "attributes": {
            "description": "The category's fields (OLX names and choice values with categoryId). An empty array means none.",
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                }
              },
              {
                "type": "array",
                "maxItems": 0
              }
            ],
            "examples": [
              {
                "make": "3",
                "type": "1",
                "new_used": "1"
              }
            ]
          },
          "images": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "url"
              ]
            }
          }
        },
        "required": [
          "title",
          "description",
          "price"
        ],
        "examples": [
          {
            "title": "Dell Latitude 5440",
            "description": "16 GB RAM, 512 GB SSD, 1 year warranty",
            "price": 899,
            "categoryId": "175",
            "locationId": "47",
            "attributes": {
              "make": "3",
              "type": "1",
              "new_used": "1"
            },
            "images": [
              {
                "url": "https://shop.example.com/dell-5440.jpg"
              }
            ]
          }
        ]
      },
      "Resolution": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "action": {
                "const": "link"
              },
              "adId": {
                "type": "string"
              },
              "replace": {
                "type": "boolean"
              }
            },
            "required": [
              "action",
              "adId"
            ]
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "const": "forget"
              },
              "force": {
                "type": "boolean"
              }
            },
            "required": [
              "action"
            ]
          }
        ]
      },
      "Accepted": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued"
            ]
          }
        },
        "required": [
          "jobId",
          "status"
        ]
      },
      "AdStatus": {
        "type": "string",
        "enum": [
          "active",
          "pending_review",
          "limited",
          "rejected",
          "expired",
          "inactive",
          "sold",
          "deleted",
          "unknown"
        ],
        "description": "`limited`: the account used its free ads in that category; the ad needs a paid OLX package to be shown. `inactive`: deactivated (a PUT republishes it). `sold`: marked as sold."
      },
      "AdMetrics": {
        "type": "object",
        "properties": {
          "searchViews": {
            "type": "integer",
            "minimum": 0
          },
          "views": {
            "type": "integer",
            "minimum": 0
          },
          "storyViews": {
            "type": "integer",
            "minimum": 0
          },
          "reelViews": {
            "type": "integer",
            "minimum": 0
          },
          "phoneViews": {
            "type": "integer",
            "minimum": 0
          },
          "chatLeads": {
            "type": "integer",
            "minimum": 0
          },
          "whatsAppLeads": {
            "type": "integer",
            "minimum": 0
          },
          "smsLeads": {
            "type": "integer",
            "minimum": 0
          },
          "applyLeads": {
            "type": "integer",
            "minimum": 0
          },
          "favorites": {
            "type": "integer",
            "minimum": 0
          },
          "leads": {
            "type": "integer",
            "minimum": 0
          }
        },
        "description": "`leads` = phoneViews + chatLeads + whatsAppLeads + smsLeads + applyLeads."
      },
      "SyncRecord": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string"
          },
          "adId": {
            "type": "string",
            "description": "OLX's ad id (empty while a create is in flight or parked)"
          },
          "adUrl": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/AdStatus"
          },
          "syncState": {
            "type": "string",
            "enum": [
              "creating",
              "needs_reconcile",
              "gone"
            ],
            "description": "Absent when the link is healthy"
          },
          "contentHash": {
            "type": "string"
          },
          "imagesHash": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastSyncedAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastError": {
            "type": "string"
          }
        },
        "required": [
          "productId",
          "adId",
          "status",
          "contentHash",
          "createdAt",
          "lastSyncedAt"
        ]
      },
      "ErrorCode": {
        "type": "string",
        "description": "Stable codes: branch on these, not on messages.",
        "enum": [
          "unauthorized",
          "not_found",
          "invalid_product_id",
          "invalid_listing",
          "invalid_resolution",
          "link_conflict",
          "healthy_link",
          "queue_full",
          "shutting_down",
          "payload_too_large",
          "bad_request",
          "internal_error",
          "auth_failed",
          "olx_rejected",
          "outcome_unknown",
          "image_upload_failed",
          "reconcile_required",
          "endpoint_not_configured",
          "sdk_error",
          "cancelled"
        ]
      },
      "ErrorInfo": {
        "type": "object",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "description": "OLX's HTTP status, when OLX answered"
          },
          "details": {
            "type": "object",
            "description": "Depends on the code: `issues` (invalid_listing), `olxMessage` / `olxErrors` (olx_rejected, e.g. {\"location_id\": [\"Please select a more specific location.\"]}), `reason` (reconcile_required), `adId`.",
            "additionalProperties": true
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ErrorInfo"
              },
              {
                "type": "object",
                "properties": {
                  "requestId": {
                    "type": "string"
                  }
                },
                "required": [
                  "requestId"
                ]
              }
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Job": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "upsert",
              "remove",
              "deactivate",
              "activate",
              "mark_sold",
              "refresh"
            ]
          },
          "productId": {
            "type": "string"
          },
          "force": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "cancelled"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "result": {
            "description": "When succeeded. upsert: { action: created | updated | republished | unchanged, record }. remove: { action: deleted, adId }. deactivate / mark_sold: { record }. activate: { result, record }. refresh: { updated, missing, checked }.",
            "type": "object",
            "additionalProperties": true
          },
          "error": {
            "$ref": "#/components/schemas/ErrorInfo"
          }
        },
        "required": [
          "id",
          "type",
          "productId",
          "status",
          "createdAt"
        ]
      },
      "Status": {
        "type": "object",
        "properties": {
          "session": {
            "type": "object",
            "properties": {
              "loggedIn": {
                "type": "boolean"
              },
              "savedAt": {
                "type": "string"
              },
              "cookieCount": {
                "type": "integer"
              }
            }
          },
          "missingEndpoints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "queue": {
            "type": "object",
            "additionalProperties": true
          },
          "writesLastHour": {
            "type": "integer"
          },
          "needsAttention": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "productId": {
                  "type": "string"
                },
                "syncState": {
                  "type": "string"
                },
                "lastError": {
                  "type": "string"
                }
              }
            }
          }
        },
        "additionalProperties": true
      }
    }
  }
}
